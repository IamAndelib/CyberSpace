<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Cyberspace" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/cs_black</item>
        <item name="android:colorAccent">@color/cs_cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Cyberspace.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cs_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Cyberspace</item>
    </style>
</resources>
